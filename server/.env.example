# MongoDB Atlas connection string. Leave empty to auto-boot an in-memory MongoDB (demo mode)
MONGODB_URI=
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Admin console credentials (defaults shown; override in .env)
ADMIN_EMAIL=bilawal@gmail.com
ADMIN_PASSWORD=Bilawal
# Secret used to sign session bearer tokens (any long random string)
AUTH_SECRET=echo-demo-secret-change-me
